# Supabase PostgreSQL template. Values are generated privately after acceptance.
APP_NAME=NFCheck
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Empty APP_URL resolves from Vercel's production-domain system variable at startup.
# Other hosts require the explicit stable HTTPS URL.
APP_URL=
NFCHECK_CLOUD=true
# Automatic-direction defaults; cron stays disabled until a private token and runner are configured.
NFCHECK_OPERATING_DAY_CUTOFF=00:00
CRON_SECRET=
# Managed host must overwrite forwarded headers; direct container access stays private.
NFCHECK_TRUSTED_PROXIES=*
NFCHECK_UI_PREVIEW=false
NFCHECK_NFC_SIMULATOR=false
NFCHECK_HARDWARE_LAB=false
NFCHECK_PHOTO_DISK=s3
NFCHECK_PASSWORD_RECOVERY=false
NFCHECK_DUPLICATE_SECONDS=10
ANOMALY_THRESHOLD_RULES=false
AI_SUMMARIES_ENABLED=false
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_SCHEMA=nfcheck_online
# Restricted application account; never the provider owner/root account.
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/app/storage/framework/database-ca.crt
NFCHECK_DB_CA_BASE64=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
NFCHECK_S3_ACCESS_KEY_ID=
NFCHECK_S3_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=nfcheck-photos
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Delivery/recovery remains disabled; never log reset links in production.
MAIL_MAILER=array
PORT=8080
