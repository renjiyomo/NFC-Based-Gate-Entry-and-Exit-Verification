# REVIEW TEMPLATE ONLY. Do not copy over this workstation's .env.
# Replace placeholders privately after host/domain/database/mail approval.
APP_NAME=NFCheck
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nfcheck.example.invalid
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
NFCHECK_UI_PREVIEW=false
NFCHECK_NFC_SIMULATOR=false
NFCHECK_HARDWARE_LAB=false
NFCHECK_REVIEW_SECONDS=30
NFCHECK_DUPLICATE_SECONDS=10
ACTIVITY_CHECKS_ENABLED=true
LOG_CHANNEL=daily
LOG_LEVEL=warning
# Example diagnostic-log rotation, subject to institutional retention approval.
LOG_DAILY_DAYS=14
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=nfcheck
DB_USERNAME=nfcheck_app
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.example.invalid
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=security@example.invalid
MAIL_FROM_NAME="${APP_NAME}"
AI_SUMMARIES_ENABLED=false
VITE_APP_NAME="${APP_NAME}"
