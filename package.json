{
  "name": "nfcheck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:nfc": "node --test tests/frontend/*.test.mjs",
    "format": "prettier --write resources/js resources/css vite.config.ts tsconfig.json",
    "format:check": "prettier --check resources/js resources/css vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "@inertiajs/react": "^3.11.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "laravel-vite-plugin": "^3.2.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
